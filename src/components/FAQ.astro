---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  items?: FAQItem[];
}

const {
  title = "Frequently Asked Questions",
  subtitle = "Everything you need to know about Seoul Indies.",
  items = [
    {
      question: "What is Seoul Indies?",
      answer:
        "Seoul Indies is a Korean-English bilingual community for indie game developers, enthusiasts, and anyone interested in making or playing independent games.",
    },
    {
      question: "Do I need to be a game developer to join?",
      answer:
        "Not at all! Players, artists, musicians, writers, students, and anyone interested in indie games are welcome.",
    },
    {
      question: "Are the meetups free?",
      answer:
        "It depends on the event. Check the details for each meetup to see whether there is an entry fee or any additional costs.",
    },
    {
      question: "Can I showcase my game?",
      answer:
        "Absolutely! We encourage developers to bring their projects, share demos, playtest their games, and get feedback from the community.",
    },
    {
      question: "Do I need to speak Korean?",
      answer:
        "No. Seoul Indies is a Korean-English bilingual community. You are welcome whether you speak Korean, English, or both.",
    },
    {
      question: "How can I join the community?",
      answer:
        "Join our Discord or contact us through our social media channels to hear about upcoming meetups and community activities.",
    },
  ],
} = Astro.props;
---

<section class="mx-auto w-full max-w-4xl py-12">
  <header class="mb-8">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
      {title}
    </h2>
    <p class="mt-3 text-slate-400">{subtitle}</p>
  </header>

  <div class="divide-y divide-slate-700 border-y border-slate-700">
    {items.map((item, index) => (
      <details class="group">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-semibold transition hover:text-slate-300 [&::-webkit-details-marker]:hidden">
          <span class="flex gap-4">
            <span class="text-sm tabular-nums text-slate-500">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span>{item.question}</span>
          </span>

          <svg
            class="h-5 w-5 shrink-0 transition-transform duration-200 group-open:rotate-45"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path d="M12 5v14M5 12h14" />
          </svg>
        </summary>

        <div class="pb-5 pl-9 pr-8 leading-relaxed text-slate-400">
          {item.answer}
        </div>
      </details>
    ))}
  </div>
</section>