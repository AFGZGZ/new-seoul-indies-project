---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const games = await getCollection('games');

const sortedGames = [...games].sort((a, b) => {
  const dateA = a.data.publishDate
    ? new Date(a.data.publishDate).getTime()
    : 0;
  const dateB = b.data.publishDate
    ? new Date(b.data.publishDate).getTime()
    : 0;

  return dateB - dateA;
});

const genres = [...new Set(
  games.map((game) => game.data.genre).filter(Boolean)
)].sort();

const statuses = [...new Set(
  games.map((game) => game.data.status).filter(Boolean)
)].sort();
---

<Layout title="Explore Indie Games">
  <main class="mx-auto max-w-7xl px-4">
    <header class="mb-10">
      <!-- <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-indigo-600">
        Seoul Indies
      </p>
      <h1 class="text-4xl font-bold tracking-tight md:text-5xl">
        Explore Indie Games
      </h1>
      <p class="mt-4 max-w-2xl text-gray-500">
        Discover games created by Korea's indie game community.
      </p> -->
       
       <h1 style="font-size: 2.5rem; margin-bottom: 0.1rem;">Games 게임</h1>
  <p  style="margin-bottom: 2rem;">Made by people in our community</p>

    </header>

    <!-- Search and filters -->
    <section class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <label class="block">
        <span class="mb-2 block text-sm font-medium">Search games</span>
        <input
          id="game-search"
          type="search"
          placeholder="Search title, developer..."
          class="w-full  border border-gray-200 bg-white px-4 py-3 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
        />
      </label>

      <label class="block">
        <span class="mb-2 block text-sm font-medium">Genre</span>
        <select
          id="game-genre"
          class="w-full  border border-gray-200 bg-white px-4 py-3"
        >
          <option value="">All genres</option>
          {genres.map((genre) => (
            <option value={genre}>{genre}</option>
          ))}
        </select>
      </label>

      <label class="block">
        <span class="mb-2 block text-sm font-medium">Development status</span>
        <select
          id="game-status"
          class="w-full  border border-gray-200 bg-white px-4 py-3"
        >
          <option value="">All statuses</option>
          {statuses.map((status) => (
            <option value={status}>{status}</option>
          ))}
        </select>
      </label>

      <label class="block">
        <span class="mb-2 block text-sm font-medium">Sort by</span>
        <select
          id="game-sort"
          class="w-full  border border-gray-200 bg-white px-4 py-3"
        >
          <option value="newest">Newest</option>
          <option value="az">Title A–Z</option>
          <option value="za">Title Z–A</option>
        </select>
      </label>
    </section>

    <div class="mb-6 flex items-center justify-between gap-4">
      <p id="game-count" class="text-sm text-gray-500" aria-live="polite">
        {games.length} games
      </p>
      <button
        id="game-reset"
        type="button"
        class="text-sm font-medium text-indigo-600 hover:text-indigo-800"
      >
        Clear filters
      </button>
    </div>

    <!-- All cards are rendered at build time -->
    <div id="games-grid" class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {sortedGames.map((game) => (
        <article
          class="game-card group overflow-hidden  border border-gray-200 bg-white transition "
          data-title={game.data.title}
          data-description={game.data.description ?? ''}
          data-developer={game.data.developer ?? ''}
          data-genre={game.data.genre ?? ''}
          data-status={game.data.status ?? ''}
          data-date={game.data.publishDate
            ? new Date(game.data.publishDate).getTime()
            : 0}
          data-original-index={sortedGames.indexOf(game)}
        >
          <a href={`/games/${game.id}/`} class="block h-full">
            {game.data.cover && (
              <img
                src={game.data.cover ?? game.data.cover}
                alt={`${game.data.title} cover`}
                loading="lazy"
                class="aspect-video w-full object-cover"
              />
            )}

            <div class="p-5">
              {/* <div class="mb-3 flex flex-wrap gap-2">
                {game.data.genre && (
                  <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700">
                    {game.data.genre}
                  </span>
                )}
                {game.data.status && (
                  <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600">
                    {game.data.status}
                  </span>
                )}
              </div> */}

              <h2 class="text-xl font-bold">
                {game.data.title}
              </h2>

              {game.data.developer && (
                <p class="mt-1 text-sm text-gray-500">
                  By {game.data.developer}
                </p>
              )}

              <p class="mt-3 line-clamp-3 text-sm leading-6 text-gray-600">
                {game.data.description}
              </p>
            </div>
          </a>
        </article>
      ))}
    </div>

    <div id="games-empty" class="hidden border border-dashed border-gray-300 p-12 text-center">
      <h2 class="text-xl font-semibold">No games found</h2>
      <p class="mt-2 text-gray-500">Try changing your search or filters.</p>
    </div>
  </main>
</Layout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>('#game-search')!;
  const genreSelect = document.querySelector<HTMLSelectElement>('#game-genre')!;
  const statusSelect = document.querySelector<HTMLSelectElement>('#game-status')!;
  const sortSelect = document.querySelector<HTMLSelectElement>('#game-sort')!;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.game-card'));
  const grid = document.querySelector<HTMLElement>('#games-grid')!;
  const count = document.querySelector<HTMLElement>('#game-count')!;
  const empty = document.querySelector<HTMLElement>('#games-empty')!;
  const reset = document.querySelector<HTMLButtonElement>('#game-reset')!;

  function readURL() {
    const params = new URLSearchParams(window.location.search);

    searchInput.value = params.get('search') ?? '';
    genreSelect.value = params.get('genre') ?? '';
    statusSelect.value = params.get('status') ?? '';

    const requestedSort = params.get('sort') ?? 'newest';
    sortSelect.value = ['newest', 'az', 'za'].includes(requestedSort)
      ? requestedSort
      : 'newest';
  }

  function updateURL() {
    const url = new URL(window.location.href);

    const values: Record<string, string> = {
      search: searchInput.value.trim(),
      genre: genreSelect.value,
      status: statusSelect.value,
      sort: sortSelect.value === 'newest' ? '' : sortSelect.value,
    };

    for (const [key, value] of Object.entries(values)) {
      if (value) url.searchParams.set(key, value);
      else url.searchParams.delete(key);
    }

    window.history.replaceState({}, '', url);
  }

  function filterGames(updateHistory = true) {
    const query = searchInput.value.trim().toLowerCase();
    const genre = genreSelect.value;
    const status = statusSelect.value;

    const filtered = cards.filter((card) => {
      const searchableText = [
        card.dataset.title,
        card.dataset.description,
        card.dataset.developer,
      ].join(' ').toLowerCase();

      return (
        searchableText.includes(query) &&
        (!genre || card.dataset.genre === genre) &&
        (!status || card.dataset.status === status)
      );
    });

    filtered.sort((a, b) => {
      if (sortSelect.value === 'az') {
        return (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '');
      }

      if (sortSelect.value === 'za') {
        return (b.dataset.title ?? '').localeCompare(a.dataset.title ?? '');
      }

      return Number(b.dataset.date ?? 0) - Number(a.dataset.date ?? 0);
    });

    for (const card of cards) {
      card.hidden = true;
    }

    for (const card of filtered) {
      card.hidden = false;
      grid.appendChild(card);
    }

    count.textContent = `${filtered.length} game${filtered.length === 1 ? '' : 's'} found`;
    empty.classList.toggle('hidden', filtered.length > 0);

    if (updateHistory) updateURL();
  }

  searchInput.addEventListener('input', () => filterGames());
  genreSelect.addEventListener('change', () => filterGames());
  statusSelect.addEventListener('change', () => filterGames());
  sortSelect.addEventListener('change', () => filterGames());

  reset.addEventListener('click', () => {
    searchInput.value = '';
    genreSelect.value = '';
    statusSelect.value = '';
    sortSelect.value = 'newest';
    filterGames();
  });

  window.addEventListener('popstate', () => {
    readURL();
    filterGames(false);
  });

  readURL();
  filterGames(false);
</script>