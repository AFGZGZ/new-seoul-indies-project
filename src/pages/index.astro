---
import { getCollection } from 'astro:content';
import Layout from "../layouts/Layout.astro"
import type { CollectionEntry } from 'astro:content';
import { translations } from "../i18n/translations";
import { Image } from "astro:assets";
import seoulIndies from "../assets/images/seoulIndies.png"
import FAQ from "../components/FAQ.astro";

const t = translations.en;
const meetups: CollectionEntry<"meetups">[] = await getCollection("meetups");

const today = new Date();
today.setHours(0, 0, 0, 0);

const sortedMeetups = [...meetups].sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime()
);

const nextMeetup = sortedMeetups.find(
  (meetup) => meetup.data.date >= today
);

const previousMeetups = sortedMeetups
  .filter((meetup) => meetup.data.date < today)
  .reverse();

function formatDate(date: Date) {
  return new Intl.DateTimeFormat("en", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(date);
}
---
<Layout title={t.siteTitle}>
<section class="mb-12 grid grid-cols-[3fr_2fr] items-center gap-6  p-4 sm:gap-8 sm:p-8 md:py-16">
  <div class="min-w-0">
    <h2 class="mb-4 text-2xl font-bold leading-tight sm:text-4xl lg:text-5xl">
      Welcome! 어서오세요!
    </h2>

    <p class="mb-4 text-sm leading-relaxed text-slate-700 sm:text-lg">
      Seoul Indies is a Korean-English bilingual meetup for game developers,
      enthusiasts, and generally cool people. Show your games, play some games,
      get feedback, and hang out.
    </p>

    <p class="text-sm leading-relaxed text-slate-700 sm:text-lg">
      Join our Discord, or reach out to us on socials with any questions you may have!
    </p>
  </div>

  <div class="min-w-0">
    <Image
      src={seoulIndies}
      alt="Seoul Indies"
      width={500}
      quality={80}
      class="block h-auto w-full rounded-lg"
    />
  </div>
</section>
<!-- Community Meetups -->
<section class="mb-16">
  <div class="mb-6 flex items-end justify-between gap-4">
    <div>
      <h3 class="text-2xl font-bold sm:text-3xl">Community Meetups</h3>
      <p class="mt-2 text-sm text-slate-500 sm:text-base">
        Meet developers, play indie games, and share what you're making.
      </p>
    </div>
  </div>

  <!-- Next meetup -->
  {nextMeetup ? (
    <a
      href={`/meetups/${nextMeetup.id}/`}
      class="group mb-10 grid overflow-hidden border border-slate-700 transition hover:border-slate-500 sm:grid-cols-5"
    >
      <div class="flex flex-col justify-center p-6 sm:col-span-3 sm:p-8">
        <span class="mb-4 w-fit rounded-full bg-slate-800 px-3 py-1 text-xs font-semibold text-slate-300">
          NEXT MEETUP
        </span>

        <p class="mb-2 text-sm text-slate-400">
          {formatDate(nextMeetup.data.date)}
          {nextMeetup.data.startTime && ` · ${nextMeetup.data.startTime}`}
        </p>

        <h4 class="mb-4 text-2xl font-bold transition group-hover:text-slate-300 sm:text-3xl">
          {nextMeetup.data.title}
        </h4>

        <p class="mb-2 text-sm text-slate-300">
          <span class="font-semibold text-white">Location:</span>{" "}
          {nextMeetup.data.location}
        </p>

        <p class="mb-6 text-sm text-slate-300">
          <span class="font-semibold text-white">Entry:</span>{" "}
          {nextMeetup.data.fee}
        </p>

        <span class="font-semibold">
          Meetup details <span aria-hidden="true">→</span>
        </span>
      </div>

      <div class="flex min-h-48 flex-col items-center justify-center bg-slate-800 p-6 text-center sm:col-span-2 sm:min-h-64">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">
          Save the date
        </p>
        <p class="mt-2 text-5xl font-bold">
          {nextMeetup.data.date.getDate()}
        </p>
        <p class="mt-1 text-lg">
          {new Intl.DateTimeFormat("en", {
            month: "long",
          }).format(nextMeetup.data.date)}
        </p>
        <p class="text-sm text-slate-400">
          {nextMeetup.data.date.getFullYear()}
        </p>
      </div>
    </a>
  ) : (
    <div class="mb-10 rounded-2xl border border-slate-700 p-6 sm:p-8">
      <h4 class="text-xl font-bold">No upcoming meetups announced yet</h4>
      <p class="mt-2 text-slate-400">
        Check back soon for our next community gathering!
      </p>
    </div>
  )}

  <!-- Previous meetups carousel -->
  <div class="mb-4 flex items-center justify-between">
    <h4 class="text-xl font-bold">Previous Meetups</h4>
    {previousMeetups.length > 1 && (
      <span class="text-xs text-slate-500">Scroll to explore →</span>
    )}
  </div>

  {previousMeetups.length > 0 ? (
    <div class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4">
      {previousMeetups.map((meetup) => (
        <a
          href={`/meetups/${meetup.id}/`}
          class="group w-[80%] shrink-0 snap-start rounded-xl border border-slate-700 p-5 transition hover:border-slate-500 sm:w-[calc(50%-0.5rem)] lg:w-[calc(33.333%-0.667rem)]"
        >
          <p class="mb-3 text-sm text-slate-400">
            {formatDate(meetup.data.date)}
          </p>

          <h5 class="mb-3 text-lg font-bold transition group-hover:text-slate-300">
            {meetup.data.title}
          </h5>

          <p class="text-sm text-slate-400">
            {meetup.data.location}
          </p>

          <p class="mt-5 text-sm font-semibold">
            View meetup <span aria-hidden="true">→</span>
          </p>
        </a>
      ))}
    </div>
  ) : (
    <p class="text-sm italic text-slate-500">
      Previous meetups will appear here after our first event.
    </p>
  )}
</section>
<FAQ />
  
    </Layout>
