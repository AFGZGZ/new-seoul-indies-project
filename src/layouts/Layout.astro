---
import LanguageSwitcher from "../components/layout/LanguageSwitcher.astro";
import { Font } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import { translations } from "../i18n/translations";
import "../styles/global.css";

const locale = Astro.currentLocale ?? "en";
const t = translations[locale === "ko" ? "ko" : "en"];
const homeUrl = getRelativeLocaleUrl(locale, "");
const newsUrl = getRelativeLocaleUrl(locale, "blog");
const gamesUrl = getRelativeLocaleUrl(locale, "games");
// const presentingUrl = getRelativeLocaleUrl(locale, "presenting");
// const friendsUrl = getRelativeLocaleUrl(locale, "friends");
const { title } = Astro.props;

interface Props {
  title: string;
}

---

<html lang={Astro.currentLocale ?? "en"}>
  <head>
 <Font cssVariable="--font-ibm-plex-mono" />
  
    <meta charset="utf-8" />
    <title>{title} — Seoul Indies</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
<body
  class="mx-auto max-w-[900px] px-4 py-6 sm:px-8 sm:py-8"
  style="font-family: var(--font-ibm-plex-mono); background: #ffffff; color: #0f1216; line-height: 1.6;"
>
    

<header class="sticky top-0 z-50 -mx-4 mb-12 border-b border-slate-700 pb-4 bg-white/95 px-4 pb-4 pt-4 backdrop-blur-md">
  <div class="flex items-center justify-between gap-4">
    <a
      href={homeUrl}
      class="min-w-0 text-lg font-semibold no-underline sm:text-xl"
    >
      {t.siteTitle}
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden items-center gap-6 md:flex">
      <a href={newsUrl} class="no-underline hover:text-slate-500">
        {t.news}
      </a>

      <a href={gamesUrl} class="no-underline hover:text-slate-500">
        {t.games}
      </a>

      <a href="#" class="no-underline hover:text-slate-500">
        {t.presenting}
      </a>

      <a href="#" class="no-underline hover:text-slate-500">
        {t.friends}
      </a>
    </nav>

    <div class="flex shrink-0 items-center gap-3">
      <LanguageSwitcher />

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-button"
        type="button"
        class="inline-flex items-center justify-center rounded-md p-2 hover:bg-slate-100 md:hidden"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-navigation"
      >
        <svg
          id="menu-open-icon"
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>

        <svg
          id="menu-close-icon"
          xmlns="http://www.w3.org/2000/svg"
          class="hidden h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="m18 6-12 12M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile navigation -->
  <nav
    id="mobile-navigation"
    class="hidden flex-col gap-1 pt-4 md:hidden"
    aria-label="Mobile navigation"
  >
    <a
      href={newsUrl}
      class="rounded-md px-3 py-2 no-underline hover:bg-slate-100"
    >
      {t.news}
    </a>

    <a
      href={gamesUrl}
      class="rounded-md px-3 py-2 no-underline hover:bg-slate-100"
    >
      {t.games}
    </a>

    <a
      href="#"
      class="rounded-md px-3 py-2 no-underline hover:bg-slate-100"
    >
      {t.presenting}
    </a>

    <a
      href="#"
      class="rounded-md px-3 py-2 no-underline hover:bg-slate-100"
    >
      {t.friends}
    </a>
  </nav>
</header>

    <!-- Main Dynamic Content Container -->
    <main>
      <slot />
    </main>

    <!-- Shared Footer -->
  <footer style="margin-top: 4rem; border-top: 1px solid #334155; padding-top: 1.5rem; text-align: center; color: #64748b; font-size: 0.875rem;">
  <div class="mb-4 flex items-center justify-center gap-5 text-black">
    <!-- Discord -->
    <a
      href="https://discord.com/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Join our Discord"
      class="transition hover:opacity-60"
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6 fill-current" aria-hidden="true">
        <path d="M19.54 5.4A18.9 18.9 0 0 0 14.9 4a13 13 0 0 0-.6 1.23 17.5 17.5 0 0 0-4.6 0A13 13 0 0 0 9.1 4a18.8 18.8 0 0 0-4.64 1.4C1.52 9.72.73 13.93 1.13 18.08a18.8 18.8 0 0 0 5.7 2.88c.46-.63.87-1.3 1.22-2.01-.67-.25-1.3-.58-1.9-.98.16-.12.32-.25.47-.38 3.67 1.72 7.66 1.72 11.29 0 .15.13.31.26.47.38-.6.4-1.23.73-1.9.98.35.71.76 1.38 1.22 2.01a18.7 18.7 0 0 0 5.7-2.88c.47-4.82-.8-8.99-3.86-12.68ZM8.52 15.2c-1.1 0-2-1-2-2.22s.88-2.22 2-2.22 2.02 1 2 2.22c0 1.22-.88 2.22-2 2.22Zm6.96 0c-1.1 0-2-1-2-2.22s.88-2.22 2-2.22 2.02 1 2 2.22c0 1.22-.87 2.22-2 2.22Z" />
      </svg>
    </a>

    <!-- X -->
    <a
      href="https://x.com/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Follow us on X"
      class="transition hover:opacity-60"
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6 fill-current" aria-hidden="true">
        <path d="M18.9 2H22l-6.78 7.75L23.2 22h-6.25l-4.9-7.4L5.58 22H2.45l7.25-8.3L1.8 2h6.4l4.43 6.76L18.9 2Zm-1.1 18h1.73L7.28 3.9H5.43L17.8 20Z" />
      </svg>
    </a>
<!-- Bluesky -->
<a
  href="https://bsky.app/"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Follow us on Bluesky"
  class="transition hover:opacity-60"
>
  <svg viewBox="0 0 24 24" class="h-6 w-6 fill-current" aria-hidden="true">
    <path d="M5.2 3.8C8 5.9 11 10.2 12 12.5c1-2.3 4-6.6 6.8-8.7 2-1.5 5.2-2.6 5.2 1 0 .7-.4 5.9-.7 6.8-.9 3.1-4.1 3.9-7 3.4 5.1.9 6.4 3.8 3.6 6.7-5.3 5.4-7.6-1.4-8.2-3.2-.1-.4-.2-.6-.3-.6s-.2.2-.3.6c-.6 1.8-2.9 8.6-8.2 3.2-2.8-2.9-1.5-5.8 3.6-6.7-2.9.5-6.1-.3-7-3.4C-.8 10.7-1.2 5.5-1.2 4.8c0-3.6 3.2-2.5 5.2-1Z" transform="translate(1.2 0)" />
  </svg>
</a>

<!-- Facebook -->
<a
  href="https://facebook.com/"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Follow us on Facebook"
  class="transition hover:opacity-60"
>
  <svg viewBox="0 0 24 24" class="h-6 w-6 fill-current" aria-hidden="true">
    <path d="M13.5 21v-8.2h2.8l.4-3.2h-3.2v-2c0-.9.3-1.6 1.6-1.6h1.7V3.1c-.3 0-1.4-.1-2.6-.1-2.6 0-4.4 1.6-4.4 4.5v2.1H7v3.2h2.8V21h3.7Z" />
  </svg>
</a>
    <!-- Instagram -->
    <a
      href="https://instagram.com/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Follow us on Instagram"
      class="transition hover:opacity-60"
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6 fill-none stroke-current" stroke-width="1.8" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none" />
      </svg>
    </a>

 <a
  href="https://www.meetup.com/"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Meetup"
  class="transition hover:opacity-60"
>
  <svg
    viewBox="0 0 32 32"
    class="h-6 w-6 fill-current"
    aria-hidden="true"
  >
    <path d="M31.969 26.984c-.401-2.572-5.163-.593-5.459-3.411c-.417-4 5.531-12.615 5.063-15.964c-.417-3.005-2.453-3.64-4.219-3.677c-1.715-.025-2.167.245-2.745.584c-.339.192-.817.577-1.484-.057c-.443-.423-.745-.713-1.208-1.089c-.24-.192-.62-.432-1.261-.525c-.629-.099-1.463 0-1.984.219c-.532.229-.937.625-1.369 1c-.433.375-1.532 1.599-2.548 1.145c-.448-.192-1.948-.943-3.031-1.405c-2.084-.901-5.093.557-6.183 2.489C3.926 9.157.745 20.428.254 21.913c-1.077 3.333 1.381 6.052 4.683 5.895c1.401-.067 2.333-.572 3.213-2.181c.511-.928 5.308-13.448 5.667-14.057c.261-.432 1.125-1.005 1.855-.636c.735.38.88 1.161.771 1.896c-.219 1.193-3.557 8.839-3.693 9.699c-.219 1.473.48 2.285 2.011 2.369c1.043.052 2.089-.317 2.912-1.88c.521-.871 5.797-11.557 6.265-12.271c.521-.781.937-1.043 1.475-1.011c.411.02 1.061.125.9 1.353c-.161 1.209-4.452 9.043-4.9 10.959c-.605 2.573.801 5.167 3.124 6.308c1.48.728 7.959 1.968 7.433-1.371z" />
  </svg>
</a>
  </div>

  <p>© {new Date().getFullYear()} Seoul Indies</p>
</footer>
  </body>
  <script>
  const menuButton = document.querySelector<HTMLButtonElement>(
    "#mobile-menu-button"
  );
  const mobileNavigation = document.querySelector<HTMLElement>(
    "#mobile-navigation"
  );
  const openIcon = document.querySelector<SVGElement>("#menu-open-icon");
  const closeIcon = document.querySelector<SVGElement>("#menu-close-icon");

  menuButton?.addEventListener("click", () => {
    if (!mobileNavigation) return;

    const isExpanded =
      menuButton.getAttribute("aria-expanded") === "true";
    const shouldOpen = !isExpanded;

    mobileNavigation.classList.toggle("hidden", !shouldOpen);
    mobileNavigation.classList.toggle("flex", shouldOpen);

    openIcon?.classList.toggle("hidden", shouldOpen);
    closeIcon?.classList.toggle("hidden", !shouldOpen);

    menuButton.setAttribute("aria-expanded", String(shouldOpen));
    menuButton.setAttribute(
      "aria-label",
      shouldOpen ? "Close navigation menu" : "Open navigation menu"
    );
  });
</script>
</html>