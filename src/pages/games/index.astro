---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const games: CollectionEntry<'games'>[] = await getCollection('games');
---

<Layout title="Games Showcase">
  
  <div style="margin-bottom: 2.5rem;">
    <h1 style="font-size: 2.5rem; margin: 0 0 0.5rem 0;">Indie Games Directory</h1>
    <p style="color: #94a3b8; font-size: 1.1rem; margin: 0;">
      Discover projects, prototypes, and finished games built by developers in Seoul.
    </p>
  </div>

  {games.length === 0 ? (
    <div style="background: #1e293b; padding: 3rem; border-radius: 12px; border: 1px solid #334155; text-align: center;">
      <p style="color: #94a3b8; font-size: 1.1rem; margin-bottom: 1.5rem;">No games have been added to the showcase yet.</p>
      <a href="/admin" style="background: #38bdf8; color: #0f172a; padding: 0.6rem 1.2rem; border-radius: 6px; font-weight: bold; text-decoration: none;">Add the first game via Admin</a>
    </div>
  ) : (
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
      {games.map((game: CollectionEntry<'games'>) => (
        <article style="background: #1e293b; border-radius: 10px; border: 1px solid #334155; overflow: hidden; display: flex; flex-direction: column;">
          
          {/* Optional Cover Image */}
          {game.data.cover && (
            <div style="height: 160px; background: #0f172a; overflow: hidden;">
              <img src={game.data.cover} alt={game.data.title} style="width: 100%; height: 100%; object-fit: cover;" />
            </div>
          )}

          <div style="padding: 1.5rem; display: flex; flex-direction: column; flex-grow: 1;">
            
            {/* Status Badge */}
            <div style="margin-bottom: 0.75rem;">
              <span style="font-size: 0.75rem; background: #334155; color: #38bdf8; padding: 0.2rem 0.6rem; border-radius: 999px; font-weight: 500; text-transform: uppercase;">
                {game.data.status}
              </span>
            </div>

            <h2 style="margin: 0 0 0.5rem 0; font-size: 1.35rem;">
              <a href={`/games/${game.id}`} style="color: #f8fafc; text-decoration: none;">{game.data.title}</a>
            </h2>
            
            <p style="color: #94a3b8; font-size: 0.9rem; margin: 0 0 1.5rem 0;">
              By <strong style="color: #cbd5e1;">{game.data.developer}</strong>
            </p>

            <div style="margin-top: auto;">
              <a href={`/games/${game.id}`} style="display: inline-block; background: #38bdf8; color: #0f172a; padding: 0.5rem 1rem; border-radius: 6px; font-size: 0.875rem; font-weight: bold; text-decoration: none;">
                View Project &rarr;
              </a>
            </div>

          </div>
        </article>
      ))}
    </div>
  )}

</Layout>