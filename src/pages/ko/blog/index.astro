---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const posts: CollectionEntry<'posts'>[] = await getCollection('posts');
---

<Layout title="Blog">
  <!-- <p><a href="/" style="color: #38bdf8; text-decoration: none;">&larr; Home</a></p> -->
  <h1 style="font-size: 2.5rem; margin-bottom: 0.1rem;">News 뉴스</h1>
  <p  style="margin-bottom: 2rem;">Updates from our community</p>

  <div class="flex flex-col gap-6">
      {posts.map((post) => (
        <article
          class="group overflow-hidden border border-slate-200 transition-colors hover:border-slate-400"
        >
          <a
            href={`/blog/${post.id}`}
            class="grid grid-cols-1 sm:grid-cols-[220px_1fr]"
          >
            {post.data.coverImage && (
              <div class="aspect-[16/10] overflow-hidden bg-slate-100 sm:aspect-auto sm:min-h-full">
                <img
                  src={post.data.coverImage}
                  alt={post.data.title}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
            )}

            <div class="p-5 sm:p-6">
              {post.data.publishDate && (
                <span class="text-xs font-medium uppercase tracking-wider text-slate-500">
                  {post.data.publishDate}
                </span>
              )}

              <h2 class="mb-3 mt-2 text-xl font-semibold tracking-tight text-slate-900 transition-colors group-hover:text-slate-600">
                {post.data.title}
              </h2>

              {post.data.excerpt && (
                <p class="mb-4 leading-7 text-slate-600">
                  {post.data.excerpt}
                </p>
              )}

              <span class="text-sm font-medium text-slate-500">
                Read full post &rarr;
              </span>
            </div>
          </a>
        </article>
      ))}
    </div>
</Layout>