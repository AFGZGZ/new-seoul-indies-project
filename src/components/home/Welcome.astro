---
import { Image } from "astro:assets";
import seoulIndies from "../../assets/images/seoulIndies.png";

const { t } = Astro.props;
---

<section
  class="mb-12 grid grid-cols-1 items-center gap-6 p-4 sm:gap-8 sm:p-8 md:grid-cols-[3fr_2fr] md:py-16"
>
  {/* Image first on mobile */}
  <div class="order-1 min-w-0 md:order-2">
    <Image
      src={seoulIndies}
      alt="Seoul Indies"
      width={500}
      quality={80}
      class="block h-auto w-full rounded-lg"
    />
  </div>

  {/* Text below image on mobile */}
  <div class="order-2 min-w-0 md:order-1">
    <h2 class="mb-4 text-2xl font-bold leading-tight sm:text-4xl">
      {t.welcomeT}
    </h2>

    <p class="mb-4 text-sm leading-relaxed text-slate-700 sm:text-lg">
      {t.welcomeP1}
    </p>

    <p class="text-sm leading-relaxed text-slate-700 sm:text-lg">
      {t.welcomeP2}
    </p>
  </div>
</section>