---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<'posts'>;
};

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
  
  <p><a href="/blog" style="color: #38bdf8; text-decoration: none;">&larr; Back to Blog</a></p>
  
  <article style="margin-top: 1.5rem;">
    {post.data.publishDate && (
      <span style="font-size: 0.875rem; color: #38bdf8; text-transform: uppercase;">{post.data.publishDate}</span>
    )}
    <h1 style="font-size: 2.5rem; margin: 0.5rem 0 1.5rem 0;">{post.data.title}</h1>
    
    <div style="line-height: 1.8; color: #cbd5e1; font-size: 1.05rem;">
      <Content />
    </div>
  </article>

</Layout>