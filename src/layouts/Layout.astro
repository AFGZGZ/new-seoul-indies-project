---
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { Font } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import { translations } from "../i18n/translations";
import "../styles/global.css";

const locale = Astro.currentLocale ?? "en";
const t = translations[locale === "ko" ? "ko" : "en"];
const homeUrl = getRelativeLocaleUrl(locale, "");
const newsUrl = getRelativeLocaleUrl(locale, "blog");
const gamesUrl = getRelativeLocaleUrl(locale, "games");
// const presentingUrl = getRelativeLocaleUrl(locale, "presenting");
// const friendsUrl = getRelativeLocaleUrl(locale, "friends");
const { title } = Astro.props;

interface Props {
  title: string;
}

---

<html lang={Astro.currentLocale ?? "en"}>
  <head>
 <Font cssVariable="--font-ibm-plex-mono" />
  
    <meta charset="utf-8" />
    <title>{title} — Seoul Indies</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body 
  style=" font-family: var(--font-ibm-plex-mono);
  max-width: 900px; margin: 0 auto; padding: 2rem; background: #ffffff; color: #0f1216; line-height: 1.6;">
    
    <!-- Shared Global Navigation Header -->
<header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 3rem; border-bottom: 1px solid #334155; padding-bottom: 1rem;">
  <a
    href={homeUrl}
    style="font-size: 1.25rem; font-weight: 600; text-decoration: none;"
  >
    {t.siteTitle}
  </a>

  <nav style="display: flex; gap: 1.5rem; align-items: center;">
    <a href={newsUrl} style=" text-decoration: none;">
      {t.news}
    </a>
    <a 
    
    style="text-decoration: none;">
      {t.presenting}
    </a>

    <a href={gamesUrl} style=" text-decoration: none;">
      {t.games}
    </a>

    <a  style=" text-decoration: none;">
      {t.friends}
    </a>
  </nav>

  <LanguageSwitcher />
</header>

    <!-- Main Dynamic Content Container -->
    <main>
      <slot />
    </main>

    <!-- Shared Footer -->
    <footer style="margin-top: 4rem; border-top: 1px solid #334155; padding-top: 1.5rem; text-align: center; color: #64748b; font-size: 0.875rem;">
      <p>© {new Date().getFullYear()} Seoul Indies</p>
    </footer>

  </body>
</html>